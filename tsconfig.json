{
  "compilerOptions": {
    "outDir": "./build",
    "module": "node16",
    "target": "es2016",
    "lib": ["es2017.object", "es2016", "es2015"],
    "sourceMap": false,
    "allowJs": true,
    "removeComments": false,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node16",
    "rootDir": "./src",
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "exclude": ["node_modules", "build", "dist"]
}
