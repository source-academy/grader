{
  "name": "grader",
  "version": "1.0.0",
  "main": "index.js",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "cross-env TIMEOUT=2000 jest --env=node",
    "test-coveralls": "scripts/ci.sh",
    "format:check": "prettier --list-different .",
    "format": "prettier --write ."
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8",
  "dependencies": {
    "@sourceacademy/conductor": "^0.8.3",
    "js-slang": "^1.0.88",
    "lodash": "4.18.1",
    "node-canvas-webgl": "^0.3.0"
  },
  "devDependencies": {
    "@types/jest": "^28.1.6",
    "@types/node": "^26.2.0",
    "coveralls": "^3.1.1",
    "cross-env": "^10.1.0",
    "cross-zip-cli": "^1.0.0",
    "jest": "^28.1.3",
    "prettier": "^3.7.4",
    "ts-jest": "^28.0.7",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "canvas": "^3.1.2",
    "gl": "9.0.0-rc.9"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/*.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "\\.[tj]s$": "ts-jest"
    },
    "testRegex": "/__tests__/test.*\\.ts$",
    "transformIgnorePatterns": [
      "/node_modules/(?!@sourceacademy/conductor/).+\\.js$"
    ],
    "moduleNameMapper": {
      "^@sourceacademy/conductor/common$": "<rootDir>/node_modules/@sourceacademy/conductor/dist/common/index.js",
      "^@sourceacademy/conductor/conduit$": "<rootDir>/node_modules/@sourceacademy/conductor/dist/conduit/index.js",
      "^@sourceacademy/conductor/types$": "<rootDir>/node_modules/@sourceacademy/conductor/dist/conductor/types/index.js",
      "^@sourceacademy/conductor/host$": "<rootDir>/node_modules/@sourceacademy/conductor/dist/conductor/host/index.js"
    },
    "globals": {
      "ts-jest": {
        "isolatedModules": true,
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "target": "es2020",
          "esModuleInterop": true,
          "moduleResolution": "node10",
          "ignoreDeprecations": "6.0"
        }
      }
    }
  }
}
